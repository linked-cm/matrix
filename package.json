{
  "name": "@linked.cm/matrix",
  "version": "0.1.0",
  "description": "Matrix transport for @linked.cm/messaging — WebID↔MXID identity bridge, appservice-mediated sessions, graph-mirrored room bindings, and a matrix-js-sdk client behind the portable Messaging seam.",
  "linkedPackage": true,
  "type": "module",
  "main": "lib/esm/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/esm/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linked-cm/matrix.git"
  },
  "homepage": "https://github.com/linked-cm/matrix#readme",
  "bugs": {
    "url": "https://github.com/linked-cm/matrix/issues"
  },
  "files": [
    "lib",
    "infra",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./src/package.ts",
    "./src/index.ts",
    "./src/shapes/index.ts",
    "./src/shapes/*.ts",
    "lib/esm/shapes/index.js",
    "lib/esm/shapes/*.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "npm exec linked dev",
    "build": "npm exec linked build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js"
    },
    "./package": {
      "types": "./lib/esm/package.d.ts",
      "import": "./lib/esm/package.js"
    },
    "./client": {
      "types": "./lib/esm/client.d.ts",
      "import": "./lib/esm/client.js"
    },
    "./react": {
      "types": "./lib/esm/react.d.ts",
      "import": "./lib/esm/react.js"
    },
    "./backend": {
      "types": "./lib/esm/backend/index.d.ts",
      "import": "./lib/esm/backend/index.js"
    },
    "./*.js": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    },
    "./*": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "lib/esm/*"
      ]
    }
  },
  "dependencies": {
    "@_linked/core": "^2.25.0",
    "@_linked/xsd": "^1.0.0",
    "@linked.cm/messaging": "^0.2.0"
  },
  "peerDependencies": {
    "matrix-js-sdk": ">=42.0.0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "matrix-js-sdk": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@_linked/cli": "1.39.0",
    "@types/node": "^20.12.7",
    "@types/react": "^19.3.0",
    "matrix-js-sdk": "42.0.0",
    "react": "^19.3.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0"
  },
  "keywords": [
    "linked",
    "matrix",
    "messaging",
    "chat",
    "e2ee",
    "rdf"
  ]
}
